---
import type { VenueDirectoryLayout, Locale } from "@/lib/types"
import { t, categoryName } from "@/i18n"
import FavouriteToggle from "@/components/FavouriteToggle.astro"
import CellIcon from "@/components/ui/CellIcon.astro"
interface Props { layout: VenueDirectoryLayout; locale: Locale }
const { layout, locale } = Astro.props
const strings = t(locale)
---
{/* My list venue directory: one card per category list with a line per venue,
    on the same masonry card grid as the film "by film" view (.gc-film-card
    geometry, packing from lib/venue-directory.ts). Each venue line (heart ·
    name) is one favourite toggle, its heart always visible and its hover frame
    in the card's genre colour (data-genre). Each card's title is a disclosure button that
    collapses the card to its title row; the script below re-packs the masonry
    and remembers collapsed cards per browser. The build-time packing (all
    expanded) is the SSR default. */}
<section class="gridpaper" data-venue-directory>
  <h2
    style="grid-row: 1"
    class="cell cell-truncate cell-lined gc-full bg-muted font-medium"
  ><span class="cell-text">{strings.pickVenues}</span></h2>

  {layout.groups.map((p) => (
    <div
      data-genre={p.group.listSlug}
      data-dir-card={p.group.listSlug}
      data-venues={p.group.venues.length}
      class="gc-film-card contents"
      style={`--fcol: ${p.col3}; --frow: ${p.row3}; --fcol2: ${p.col2}; --frow2: ${p.row2}; --frow1: ${p.row1}`}
    >
      <h3 class="contents">
        <button
          type="button"
          data-dir-toggle
          aria-expanded="true"
          aria-controls={`dir-venues-${p.group.listSlug}`}
          class="dir-toggle cell cell-truncate gc-film-title text-foreground font-medium cell-outline-foreground cell-underlined"
        >
          <span class="cell-text">{categoryName(locale, p.group.listSlug)}</span>
          <span class="dir-chevron"><CellIcon icon="chevron" /></span>
        </button>
      </h3>
      <div id={`dir-venues-${p.group.listSlug}`} class="contents">
        {p.group.venues.map((v, sr) => (
          <div style={`--sr: ${sr}`} class="contents">
            <FavouriteToggle venueSlug={v.slug} venueName={v.name} label={strings.favouriteVenue} variant="directory" />
          </div>
        ))}
      </div>
    </div>
  ))}

  <div
    data-dir-spacer
    style={`--fmax: ${layout.rows3}; --fmax2: ${layout.rows2}; --fmax1: ${layout.rows1}`}
    class="cell gc-full gc-film-spacer"
  />
</section>

<style>
  /* The title button is the card's first grid cell: reset the native button
     chrome and leave the last cell free for the chevron. */
  .dir-toggle {
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--foreground);
    text-align: left;
    cursor: pointer;
    padding-right: var(--cell);
  }
  .dir-toggle:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }
  /* Chevron (CellIcon) fills the title row's last cell: down = expanded,
     right = collapsed. No transition (state flips instantly). */
  .dir-chevron {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--cell);
  }
  .dir-toggle[aria-expanded="false"] .dir-chevron :global(.cell-icon) {
    rotate: -90deg;
  }
</style>

<script>
  import { packCards } from "@/lib/masonry"
  import {
    COLLAPSED_KEY,
    directoryHeights,
    parseCollapsed,
  } from "@/lib/venue-directory"

  function readCollapsed(): Set<string> {
    try {
      return parseCollapsed(localStorage.getItem(COLLAPSED_KEY))
    } catch {
      return new Set()
    }
  }

  function writeCollapsed(slugs: Set<string>) {
    try {
      localStorage.setItem(COLLAPSED_KEY, JSON.stringify([...slugs]))
    } catch {
      // Storage unavailable (private window, blocked): state lasts this page.
    }
  }

  // Apply the collapsed set to every directory: toggle the venue rows, flip
  // the chevrons, and re-pack the masonry so the grid stays gap-free at every
  // column count (the card/spacer CSS reads these vars).
  function apply(collapsed: Set<string>) {
    document
      .querySelectorAll<HTMLElement>("[data-venue-directory]")
      .forEach((section) => {
        const cards = [...section.querySelectorAll<HTMLElement>("[data-dir-card]")]
        const states = cards.map((c) => collapsed.has(c.dataset.dirCard ?? ""))
        const layout = packCards(
          directoryHeights(
            cards.map((c) => Number(c.dataset.venues) || 0),
            states,
          ),
        )
        cards.forEach((card, i) => {
          const p = layout.placements[i]
          card.style.setProperty("--fcol", String(p.col3))
          card.style.setProperty("--frow", String(p.row3))
          card.style.setProperty("--fcol2", String(p.col2))
          card.style.setProperty("--frow2", String(p.row2))
          card.style.setProperty("--frow1", String(p.row1))
          const toggle = card.querySelector<HTMLElement>("[data-dir-toggle]")
          toggle?.setAttribute("aria-expanded", String(!states[i]))
          const id = toggle?.getAttribute("aria-controls")
          const rows = id ? document.getElementById(id) : null
          rows?.toggleAttribute("hidden", states[i])
        })
        const spacer = section.querySelector<HTMLElement>("[data-dir-spacer]")
        spacer?.style.setProperty("--fmax", String(layout.rows3))
        spacer?.style.setProperty("--fmax2", String(layout.rows2))
        spacer?.style.setProperty("--fmax1", String(layout.rows1))
      })
  }

  let collapsed = readCollapsed()
  if (collapsed.size > 0) apply(collapsed)

  // Native <button>: Enter/Space fire click, so one listener covers keyboard
  // too. Only the title button toggles; venue lines (favourite toggles) don't.
  document.addEventListener("click", (e) => {
    const toggle = (e.target as Element | null)?.closest<HTMLElement>(
      "[data-dir-toggle]",
    )
    const slug = toggle?.closest<HTMLElement>("[data-dir-card]")?.dataset.dirCard
    if (!slug) return
    if (collapsed.has(slug)) collapsed.delete(slug)
    else collapsed.add(slug)
    writeCollapsed(collapsed)
    apply(collapsed)
  })

  // Another tab collapsed/expanded a card: follow it.
  window.addEventListener("storage", (e) => {
    if (e.key !== COLLAPSED_KEY) return
    collapsed = readCollapsed()
    apply(collapsed)
  })
</script>
