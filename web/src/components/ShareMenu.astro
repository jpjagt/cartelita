---
import type { Locale } from "@/lib/types"
import { t, localeTag } from "@/i18n"
import { cityConfig } from "@/lib/cities"
import CellIcon from "@/components/ui/CellIcon.astro"
interface Props {
  city: string
  locale: Locale
}
const { city, locale } = Astro.props
const strings = t(locale)
const { timezone } = cityConfig(city)
---
{/* The per-event share dropdown (desktop layout; below 760px the event panel
    takes over, EventPanel.astro): ONE element per page, moved into the
    clicked row's section and placed on its grid by the script below, so
    5,000 rows carry only a trigger button each (EventRow). Page-level data
    (locale, time zone, localized strings) rides on the menu's data-*
    attributes; per-event data is read off the row. Two actions, each one cell
    row: icon · spacer · label. */}
<div
  data-share-menu
  data-locale-tag={localeTag(locale)}
  data-timezone={timezone}
  data-template={strings.shareTemplate}
  data-copied={strings.copied}
  role="menu"
  aria-label={strings.share}
  hidden
  class="share-menu"
>
  <button type="button" role="menuitem" data-share-action="share" class="share-item">
    <span class="cell share-item-icon"><CellIcon icon="share" /></span>
    <span class="cell cell-truncate share-item-label"><span class="cell-text">{strings.share}</span></span>
  </button>
  <button type="button" role="menuitem" data-share-action="calendar" class="share-item">
    <span class="cell share-item-icon"><CellIcon icon="calendar" /></span>
    <span class="cell cell-truncate share-item-label"><span class="cell-text">{strings.addToCalendar}</span></span>
  </button>
</div>

<script>
  import { eventOf, shareEvent, addToCalendar } from "@/lib/event-actions"
  import { NARROW_QUERY } from "@/lib/breakpoints"
  import { liveGrid } from "@/lib/grid-client"
  import { onPage } from "@/lib/page-lifecycle"

  // The current page's menu; null on pages without event rows.
  let menu: HTMLElement | null = null
  const NARROW = window.matchMedia(NARROW_QUERY)

  // The open menu's row wrapper and trigger; null when closed.
  let row: HTMLElement | null = null
  let trigger: HTMLElement | null = null
  let copiedTimer = 0

  // Place the menu on the row's section grid, in px that land on cell lines
  // (every edge is measured from the event's own cells): a dropdown under the
  // event row whose icon column sits right under the trigger (the gap cell
  // right of the title), as wide as icon + spacer + the longest label —
  // shifted left if that would cross the band's right edge. Absolutely
  // positioned, so it overlays the following rows without adding a grid row
  // (no content shift).
  function place(r: HTMLElement, t: HTMLElement) {
    const section = r.closest<HTMLElement>(".gridpaper")!
    section.appendChild(menu!)
    const cell = liveGrid().cell
    const box = section.getBoundingClientRect()
    const anchor = t.getBoundingClientRect()
    const price = r.querySelector(".gc-price")!.getBoundingClientRect()
    const top = anchor.top - box.top + cell
    const bandRight = price.right - box.left
    // Widest label (incl. the "Copied" swap, so the width never jumps).
    const label = menu!.querySelector<HTMLElement>(".share-item-label .cell-text")!
    const prev = label.textContent
    let widest = 0
    for (const l of [...menu!.querySelectorAll(".share-item-label .cell-text")].map((e) => e.textContent ?? "").concat(menu!.dataset.copied ?? "")) {
      label.textContent = l
      widest = Math.max(widest, label.scrollWidth)
    }
    label.textContent = prev
    const cols = 2 + Math.max(2, Math.ceil((widest + 7) / cell))
    const width = cols * cell
    menu!.style.left = `${Math.min(anchor.left - box.left, bandRight - width)}px`
    menu!.style.top = `${top}px`
    // +2px so the right/bottom border lands on the next gridline (lines are
    // drawn on each cell's top/left edge).
    menu!.style.width = `${width + 2}px`
    menu!.style.height = `${2 * cell + 2}px`
  }

  function open(r: HTMLElement, t: HTMLElement) {
    close(false)
    row = r
    trigger = t
    trigger.setAttribute("aria-expanded", "true")
    menu!.hidden = false
    place(r, t)
    menu!.querySelector<HTMLElement>("[role=menuitem]")?.focus({ preventScroll: true })
  }

  function close(restoreFocus = true) {
    if (!row) return
    window.clearTimeout(copiedTimer)
    resetLabel()
    trigger?.setAttribute("aria-expanded", "false")
    menu!.hidden = true
    if (restoreFocus) trigger?.focus({ preventScroll: true })
    row = null
    trigger = null
  }

  const shareLabel = () =>
    menu!.querySelector<HTMLElement>("[data-share-action=share] .cell-text")!
  let shareLabelText = ""
  function resetLabel() {
    if (shareLabelText) shareLabel().textContent = shareLabelText
    shareLabelText = ""
  }

  // Confirm a clipboard fallback by swapping the label to "Copied" a moment.
  function showCopied() {
    window.clearTimeout(copiedTimer)
    if (!shareLabelText) shareLabelText = shareLabel().textContent ?? ""
    shareLabel().textContent = menu!.dataset.copied ?? ""
    copiedTimer = window.setTimeout(resetLabel, 1500)
  }

  // Keyboard navigation inside the menu (bound to each page's menu).
  function onMenuKeydown(e: KeyboardEvent) {
    if (!menu) return
    const items = [...menu.querySelectorAll<HTMLElement>("[role=menuitem]")]
    const i = items.indexOf(document.activeElement as HTMLElement)
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault()
      const step = e.key === "ArrowDown" ? 1 : -1
      items[(i + step + items.length) % items.length].focus()
    } else if (e.key === "Tab") {
      // Back on the trigger before the default action, so Tab continues
      // from the event row rather than from the end of the section.
      close()
    }
  }

  // Document/window listeners: registered once per session, acting on the
  // current page (inert where it has no menu).
  document.addEventListener("click", async (e) => {
    const m = menu
    if (!m) return
    const target = e.target as Element | null
    const t = target?.closest<HTMLElement>("[data-share-trigger]")
    if (t) {
      const r = t.closest<HTMLElement>("[data-event-row]")
      if (!r) return
      if (r === row) close()
      else open(r, t)
      return
    }
    const action = target?.closest<HTMLElement>("[data-share-action]")
    if (action && row) {
      const ev = eventOf(row)
      if (action.dataset.shareAction === "share") {
        const result = await shareEvent(ev, {
          localeTag: m.dataset.localeTag ?? "en-GB",
          template: m.dataset.template ?? "{title} — {when}, {venue}",
        })
        if (result === "copied") showCopied()
        else close()
      } else {
        addToCalendar(ev, m.dataset.timezone ?? "UTC")
        close()
      }
    }
  })

  // A press anywhere outside the menu (and its trigger) closes it, and the
  // press goes on to do whatever it does.
  document.addEventListener("pointerdown", (e) => {
    if (!row || !menu) return
    const target = e.target as Node
    if (menu.contains(target) || trigger?.contains(target)) return
    close(false)
  })

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && row) close()
  })
  // The grid can re-flow under an open menu (resize, rotation): re-place
  // it, or close it if the layout switched to the narrow one (no trigger).
  window.addEventListener("gridsync", () => {
    if (!row || !trigger) return
    if (NARROW.matches) close(false)
    else place(row, trigger)
  })

  // Each page brings its own (closed) menu.
  onPage(() => {
    menu = document.querySelector<HTMLElement>("[data-share-menu]")
    row = null
    trigger = null
    shareLabelText = ""
    window.clearTimeout(copiedTimer)
    menu?.addEventListener("keydown", onMenuKeydown)
  })
</script>
