---
import type { FilmDayLayout, Locale } from "@/lib/types"
import { localeTag, t } from "@/i18n"
import CellIcon from "@/components/ui/CellIcon.astro"
import FilmCard from "@/components/FilmCard.astro"
interface Props {
  day: FilmDayLayout
  locale: Locale
  genre: string
  /** First day of a switchable view: no breathing rows above it. syncAgenda
      re-marks it at runtime (a stale build's first day may be past). */
  first?: boolean
}
const { day, locale, genre, first = false } = Astro.props
const heading = new Date(day.date + "T00:00:00").toLocaleDateString(localeTag(locale), {
  weekday: "long", day: "numeric", month: "long",
})
---
<section data-date={day.date} data-first-day={first ? "" : undefined} class="gridpaper">
  {/* Day heading spans the full content band, same as the row layout. */}
  <h2 style="grid-row: 1" class="cell cell-lined gc-full bg-muted font-medium day-head">
    {/* The header toggles the day's events (collapsed: one note row in their
        place; syncAgenda in Layout.astro). */}
    <button type="button" data-day-toggle aria-expanded="true" class="day-toggle"
      ><span class="cell-text">{heading}</span><span class="day-chevron"><CellIcon icon="chevron" /></span></button>
  </h2>
  <button type="button" data-day-note hidden class="cell cell-truncate gc-full gc-day-note text-muted-foreground"
    ><span class="cell-text">{t(locale).eventsHidden}</span></button>

  {day.films.map((p) => <FilmCard packed={p} locale={locale} genre={genre} />)}

  {/* One blank spacer row beneath the day's films. --fmax* carry the total cell
      rows consumed by each packing so the spacer lands just below the tallest
      column at each breakpoint (see .gc-film-spacer in global.css). */}
  <div
    style={`--fmax: ${day.rows3}; --fmax2: ${day.rows2}; --fmax1: ${day.rows1}`}
    class="cell gc-full gc-film-spacer"
  />
</section>
