---
import type { AgendaEvent, Locale } from "@/lib/types"
import { t } from "@/i18n"
import FavouriteToggle from "@/components/FavouriteToggle.astro"
import CellIcon from "@/components/ui/CellIcon.astro"
interface Props {
  event: AgendaEvent
  locale: Locale
  genre: string
  /** 0-based index of this event within its day; drives grid-row via --ev. */
  index: number
}
const { event, locale, index } = Astro.props
// Mixed-category pages (My list) tint each row by its own genre.
const genre = event.genre ?? Astro.props.genre
const strings = t(locale)
const displayPrice = event.price
  ? (strings.prices[event.price] ?? event.price)
  : ""
---
{/* One event = one row of the content band:
   time · gap · title(grows) · share · place · heart · price.
   The share trigger sits in the gap right of the title and the favourite heart
   in the one right of the venue name (both revealed on hover; a favourite's
   filled heart always shows). Below 760px the event splits over two rows
   (time · title, then place · price) and a tap opens its panel instead
   (EventPanel.astro). The wrapper carries data-time for the day/row visibility
   script, data-venue for the My list filter, and data-id/data-date (the REAL
   calendar date — the section's date is the agenda's logical day, which
   differs for post-midnight shows) for the share actions, which read the rest
   off the cells (lib/event-actions.ts). It sits on the grid via
   `display: contents` so its children place directly. */}
<div
  data-event-row
  data-id={event.id}
  data-date={event.startDate}
  data-time={event.startTime ?? ""}
  data-venue={event.venueSlug}
  data-genre={genre}
  style={`--ev: ${index}`}
  class="contents"
>
  <time
    class="cell cell-truncate gc-time text-muted-foreground"
  ><span class="cell-text">{event.startTime ?? ""}</span></time>

  {/* The whole title cell IS the link, so the entire row span is clickable. */}
  <a
    data-genre={genre}
    href={event.sourceUrl}
    target="_blank"
    rel="noopener"
    class="cell cell-truncate cell-genre-hover gc-title text-foreground no-underline hover:underline"
  >
    <span class="cell-text">
      {event.title}
      {event.language && <span class="ml-7 text-muted-foreground">{event.language}</span>}
      {event.recurrenceHint && <span class="ml-7 cursor-help text-muted-foreground">{event.recurrenceHint}</span>}
    </span>
  </a>

  {/* Opens the share dropdown (ShareMenu.astro). */}
  <button
    type="button"
    data-share-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={strings.share}
    class="cell share-trigger gc-share"
  ><CellIcon icon="share" /></button>

  <FavouriteToggle
    venueSlug={event.venueSlug}
    venueName={event.venueName}
    label={strings.favouriteVenue}
    variant="place"
  />

  <div
    class="cell cell-truncate cell-right gc-price text-muted-foreground"
  ><span class="cell-text">{displayPrice}</span></div>
</div>

<script>
  // Fit the price column to its text, in whole cells (see lib/price-fit.ts).
  //  Desktop: one width per PAGE — the widest price, clamped to [3, 5] cells —
  //  published as --price-cells on <html>; global.css shifts the place column
  //  and the title's end by it, so the title absorbs the slack.
  //  Narrow (<760px): each row sizes its own price span (--pc on the row
  //  wrapper, [2, 6] cells); the place cell on row B takes the rest.
  // Text is measured with canvas measureText in the price cell's font, once
  // per distinct string, so a 5,000-row page costs no layout reads per row.
  import { cellSpan, PRICE_CELLS_DESKTOP, PRICE_CELLS_MOBILE } from "@/lib/price-fit"
  import { NARROW_QUERY } from "@/lib/breakpoints"

  const ctx = document.createElement("canvas").getContext("2d")
  const widths = new Map<string, number>()

  function textWidth(text: string, font: string): number {
    const key = `${font}\u0000${text}`
    let w = widths.get(key)
    if (w === undefined) {
      ctx!.font = font
      w = text ? ctx!.measureText(text).width : 0
      widths.set(key, w)
    }
    return w
  }

  function fitPrices() {
    const first = document.querySelector<HTMLElement>(".gc-price > .cell-text")
    if (!first || !ctx) return
    const cs = getComputedStyle(first)
    const font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`
    const priceOf = (row: Element) =>
      row.querySelector(".gc-price > .cell-text")?.textContent?.trim() ?? ""
    // --cell is written inline on each section by syncGrid; reading the
    // inline value avoids a style recalc per section. A hidden section has
    // --cell 0 (no width) and is refit when its view is shown (syncGrid →
    // gridsync).
    const cellOf = (el: HTMLElement) => parseFloat(el.style.getPropertyValue("--cell")) || 0
    const sections = [...document.querySelectorAll<HTMLElement>("section.gridpaper")]

    if (!window.matchMedia(NARROW_QUERY).matches) {
      // Desktop cells are a fixed size; take it from any laid-out section.
      const cell = Math.max(0, ...sections.map(cellOf))
      let widest = 0
      for (const text of new Set([...document.querySelectorAll("[data-event-row]")].map(priceOf))) {
        widest = Math.max(widest, textWidth(text, font))
      }
      document.documentElement.style.setProperty(
        "--price-cells",
        String(cellSpan(widest, cell, PRICE_CELLS_DESKTOP)),
      )
      return
    }
    for (const section of sections) {
      const cell = cellOf(section)
      section.querySelectorAll<HTMLElement>("[data-event-row]").forEach((row) => {
        const pc = String(cellSpan(textWidth(priceOf(row), font), cell, PRICE_CELLS_MOBILE))
        if (row.style.getPropertyValue("--pc") !== pc) row.style.setProperty("--pc", pc)
      })
    }
  }

  fitPrices()
  // syncGrid dispatches gridsync on resize/load and when a hidden view is
  // shown, after --cell is settled.
  window.addEventListener("gridsync", fitPrices)
  document.fonts?.ready.then(() => {
    widths.clear()
    fitPrices()
  })
</script>
