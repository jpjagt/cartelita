---
interface Props {
  venueSlug: string
  venueName: string
  /** Localized "Favourite venue" label (aria). */
  label: string
  /** Grid placement / visibility classes from the caller. */
  class?: string
}
const { venueSlug, venueName, label, class: className = "" } = Astro.props
---
{/* Toggles the venue in the browser's favourites (lib/favourites.ts). Every
    star for the same venue on the page flips together; aria-pressed carries the
    state and the glyph (outline/filled) is drawn from it in CSS (.fav-star). */}
<button
  type="button"
  data-fav-toggle
  data-venue={venueSlug}
  aria-pressed="false"
  aria-label={`${label}: ${venueName}`}
  title={label}
  class={`fav-star cell ${className}`}
><span class="cell-text" aria-hidden="true"></span></button>

<script>
  import {
    browserStore,
    readFavourites,
    toggleFavourite,
    FAVOURITES_EVENT,
  } from "@/lib/favourites"

  const store = browserStore()

  function paint(favs: Set<string>) {
    document
      .querySelectorAll<HTMLElement>("[data-fav-toggle]")
      .forEach((btn) =>
        btn.setAttribute(
          "aria-pressed",
          String(favs.has(btn.dataset.venue ?? "")),
        ),
      )
  }

  paint(readFavourites(store))

  // One delegated listener covers every star, including ones in views that
  // were hidden at load.
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLElement>(
      "[data-fav-toggle]",
    )
    if (!btn?.dataset.venue) return
    const favs = toggleFavourite(store, btn.dataset.venue)
    paint(favs)
    window.dispatchEvent(new CustomEvent(FAVOURITES_EVENT, { detail: favs }))
  })

  // Another tab changed the favourites: repaint, and let the My list filter
  // re-run.
  window.addEventListener("storage", () => {
    const favs = readFavourites(store)
    paint(favs)
    window.dispatchEvent(new CustomEvent(FAVOURITES_EVENT, { detail: favs }))
  })
</script>
