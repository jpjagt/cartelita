---
import { getCategoryLists } from "@/lib/queries"
import { cityConfig, MY_LIST } from "@/lib/cities"
import { type Locale } from "@/lib/types"
import { t, categoryName } from "@/i18n"
import { measureText } from "@/lib/text-metrics"
import { navVars } from "@/lib/nav-layout"
import { gridGeometry } from "@/lib/grid-geometry"
import { renderStepCss, stepTable } from "@/lib/step-table"

interface Props {
  city: string
  locale: Locale
  activeList: string
}

const { city, locale, activeList } = Astro.props
const strings = t(locale)
const cityCfg = cityConfig(city)
const LOCALES = cityCfg.locales // the locale switcher offers the CITY's locales
const lists = await getCategoryLists(city)
// Category tabs, then the visitor's own My list (favourite venues) at the end.
const navItems = [
  ...lists.map((l) => ({ slug: l.slug, label: categoryName(locale, l.slug), primary: l.primary })),
  { slug: MY_LIST, label: strings.myList, primary: true },
]

// Build-time placement. Each label is measured in the page font
// (lib/text-metrics.ts), and the whole navbar layout — link spans, wrapping,
// the locale cells — is swept over every container width into a step table
// on the header (lib/nav-layout.ts navVars → lib/step-table.ts), emitted with
// only the rules where a placement changes. Columns are offsets from
// --col-start (or --c-end for locales), never absolute lines, so they follow
// the grid geometry table. The nav script below only corrects labels the
// bundled font can't measure (data-measure: Cyrillic, Armenian).
const ems = navItems.map((l) => measureText(l.label))
const navCss = renderStepCss(
  "[data-navbar]",
  stepTable((width, narrow) =>
    navVars(ems.map((m) => m.em), LOCALES.length, gridGeometry(width, narrow), narrow),
  ),
)
---
<header class="gridpaper" data-navbar>
  <style is:inline set:html={navCss} />
  {/* Wordmark. Desktop: 11 cols × 3 rows, font 2.6× the cell. Mobile: 9 cols
      × 2 rows, font 2× (see .navbar-wordmark in global.css). Placement lives
      in CSS so the media query can override it (inline styles can't be). */}
  <a
    href={`/${city}/${locale}/${cityCfg.defaultList}`}
    class="cell cell-truncate font-semibold no-underline text-foreground navbar-wordmark"
  ><span class="cell-text">Ca<span class="mr-0.5">r</span>telita</span></a>

  {/* Category nav: links flow on row 3 right of the 11-col wordmark, wrapping
      up to row 2/1 before the locale zone, or below the wordmark when that's
      full (lib/nav-layout.ts); placed by the step table above. */}
  {navItems.map((l, i) => (
    <a
      data-genre={l.slug}
      data-navlink
      data-em={String(ems[i].em)}
      data-measure={ems[i].covered ? undefined : ""}
      href={`/${city}/${locale}/${l.slug}`}
      aria-current={l.slug === activeList ? "page" : undefined}
      style={`grid-column: calc(var(--col-start) + var(--n${i}c)) / span var(--n${i}s); grid-row: var(--n${i}r)`}
      class={`cell cell-truncate cell-genre-hover whitespace-nowrap no-underline ${l.primary ? "text-foreground" : "text-muted-foreground"}${l.slug === activeList ? " cell-genre" : ""}`}
    ><span class="cell-text">{l.label}</span></a>
  ))}

  {/* Locale switcher. Desktop: one cell per locale, top-right row 1,
      right-aligned. Mobile: restacked into the columns right of the 9-col
      wordmark, across rows 1–2 (lib/nav-layout.ts layoutLocales). */}
  {LOCALES.map((lc, i) => (
    <a
      data-locale
      data-locale-index={i}
      href={`/${city}/${lc}/${activeList}`}
      aria-current={lc === locale ? "page" : undefined}
      style={`grid-column: calc(var(--c-end) - var(--l${i}o)) / span 1; grid-row: var(--l${i}r)`}
      class="cell justify-end text-muted-foreground no-underline hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground text-xs min-[760px]:text-base"
    >
      <span class="cell-text">{lc.toUpperCase()}</span>
    </a>
  ))}

  <script>
    import { navVars } from "@/lib/nav-layout";
    import { correctVars, isNarrow, liveGrid, measureEm } from "@/lib/grid-client";

    // The build-time step table already places every link and locale cell
    // for every width. This only CORRECTS it, writing (inline, on the header)
    // just the vars that differ from the table: labels the bundled font can't
    // cover (data-measure) are re-measured in the font the browser actually
    // picked, and beyond the table's width range the layout is recomputed
    // from the same function (lib/nav-layout.ts navVars). On Latin pages it
    // writes nothing.
    function layoutNav() {
      const header = document.querySelector<HTMLElement>("header[data-navbar]");
      if (!header) return;
      const links = [...header.querySelectorAll<HTMLElement>("a[data-navlink]")];
      const ems = links.map((a) =>
        a.hasAttribute("data-measure")
          ? measureEm(a.querySelector<HTMLElement>(".cell-text") ?? a)
          : Number(a.dataset.em) || 0,
      );
      const localeCount = header.querySelectorAll("a[data-locale]").length;
      correctVars(header, navVars(ems, localeCount, liveGrid(), isNarrow()));
    }
    layoutNav();
    window.addEventListener("gridsync", layoutNav);
    // A measured label's width changes when its font arrives.
    if (document.querySelector("a[data-navlink][data-measure]")) {
      document.fonts?.ready.then(layoutNav);
    }
  </script>
</header>
