---
import type { GridRadioOption } from "@/lib/types"
import { measureText } from "@/lib/text-metrics"
import { radioVars } from "@/lib/radio-layout"
import { gridGeometry } from "@/lib/grid-geometry"
import { renderStepCss, stepTable } from "@/lib/step-table"
interface Props {
  /** Group id; emitted as data-grid-radio so a page script can find this
      control and listen for its `gridradiochange` events. */
  name: string
  options: GridRadioOption[]
  /** Selected value. The matching option carries data-active. */
  value: string
  /** horizontal: options flow left-to-right on one row. vertical: each option
      sits on its own row, stacked downward. Placement is computed by the inline
      script onto the parent .gridpaper grid, so every cell stays square and on
      the gridlines. */
  orientation?: "horizontal" | "vertical"
}
const { name, options, value, orientation = "horizontal" } = Astro.props

// Build-time placement: each label measured in the page font
// (lib/text-metrics.ts), the packing (lib/radio-layout.ts) swept over every
// container width into a step table on the group, so the first paint is
// already final. Assumes the OptionsPanel host: starting at --col-start, on
// row 2, inline unless `orientation` says vertical. Option i reads --r{i}c
// (indicator columns after the start), --r{i}s (label span), --r{i}r (row).
// The script below corrects other hosts and labels the font can't measure.
const SSR_ROW = 2
const vertical = orientation === "vertical"
const ems = options.map((o) => measureText(o.label))
const radioCss = renderStepCss(
  `[data-grid-radio="${name}"]`,
  stepTable((width, narrow) =>
    radioVars(ems.map((m) => m.em), { baseRow: SSR_ROW, vertical }, gridGeometry(width, narrow)),
  ),
)
---
{/* A radio group placed directly onto the parent .gridpaper grid. Each option
   is one square indicator cell + a label cell spanning whole cells. The wrapper
   uses `display: contents` so the cells become direct grid items (the script
   sets their grid-column/grid-row). One hidden radio per option drives keyboard
   / AT and the change event. */}
<div
  data-grid-radio={name}
  data-orientation={orientation}
  role="radiogroup"
  class="grid-radio contents"
>
  <style is:inline set:html={radioCss} />
  {options.map((opt, i) => (
    <label
      data-grid-radio-option
      data-value={opt.value}
      data-active={opt.value === value ? "" : undefined}
      class="contents cursor-pointer"
    >
      <input
        type="radio"
        name={name}
        value={opt.value}
        checked={opt.value === value}
        class="sr-only"
      />
      <span
        class="grid-radio-indicator cell"
        aria-hidden="true"
        style={`grid-column: calc(var(--gr-start-col, var(--col-start)) + var(--r${i}c)) / span 1; grid-row: var(--r${i}r)`}
      />
      <span
        class="grid-radio-label cell cell-truncate text-foreground"
        data-em={String(ems[i].em)}
        data-measure={ems[i].covered ? undefined : ""}
        style={`grid-column: calc(var(--gr-start-col, var(--col-start)) + var(--r${i}c) + 1) / span var(--r${i}s); grid-row: var(--r${i}r)`}
      >
        <span class="cell-text">{opt.label}</span>
      </span>
    </label>
  ))}
</div>

<script>
  import { radioVars } from "@/lib/radio-layout"
  import { correctVars, liveGrid, measureEm } from "@/lib/grid-client"

  // The build-time step table already packs every group for every width
  // (assuming the OptionsPanel host). This only CORRECTS it, writing inline
  // on the group just the vars that differ: a host that places the control
  // elsewhere (--gr-start-col / --gr-row / --gr-vertical), labels the bundled
  // font can't cover (data-measure, re-measured in the font the browser
  // picked), widths beyond the table. Usually it writes nothing.
  function layoutGridRadios() {
    const g = liveGrid()
    document.querySelectorAll<HTMLElement>("[data-grid-radio]").forEach((group) => {
      const grid = group.closest<HTMLElement>(".gridpaper")
      if (!grid) return
      const cs = getComputedStyle(group)
      const cssVertical = cs.getPropertyValue("--gr-vertical").trim()
      const vertical =
        cssVertical !== "" ? cssVertical === "1" : group.dataset.orientation === "vertical"
      const startCol = parseInt(cs.getPropertyValue("--gr-start-col")) || g.colStart
      const baseRow = parseInt(cs.getPropertyValue("--gr-row")) || 1
      const ems = [...group.querySelectorAll<HTMLElement>(".grid-radio-label")].map((lbl) =>
        lbl.hasAttribute("data-measure")
          ? measureEm(lbl.querySelector<HTMLElement>(".cell-text") ?? lbl)
          : Number(lbl.dataset.em) || 0,
      )
      correctVars(group, radioVars(ems, { baseRow, vertical, startOffset: startCol - g.colStart }, g))
    })
  }

  layoutGridRadios()
  window.addEventListener("gridsync", layoutGridRadios)
  if (document.querySelector(".grid-radio-label[data-measure]")) {
    document.fonts?.ready.then(layoutGridRadios)
  }

  // Wire selection: clicking an option moves data-active and emits a
  // `gridradiochange` CustomEvent (detail = value). Stateless beyond the DOM.
  function wireGridRadios() {
    document.querySelectorAll<HTMLElement>("[data-grid-radio]").forEach((group) => {
      if (group.dataset.wired) return
      group.dataset.wired = "1"
      group.addEventListener("change", (e) => {
        const input = e.target as HTMLInputElement
        if (!input.matches('input[type="radio"]')) return
        group
          .querySelectorAll<HTMLElement>("[data-grid-radio-option]")
          .forEach((opt) =>
            opt.dataset.value === input.value
              ? opt.setAttribute("data-active", "")
              : opt.removeAttribute("data-active"),
          )
        group.dispatchEvent(
          new CustomEvent("gridradiochange", { detail: input.value, bubbles: true }),
        )
      })
    })
  }
  wireGridRadios()
</script>
