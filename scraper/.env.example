# Local dev database
DATABASE_URL=postgresql://localhost:5432/cartelera_dev

# Instagram ingest — residential proxy all IG traffic exits through, used by
# both `cartelera ig-login` and the nightly capture so the session is minted
# and used from the same IP. Unset = direct connection (fine for local dev).
# IG_PROXY_URL=http://user:password@gate.provider.example:7000
