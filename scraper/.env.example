# Local dev database
DATABASE_URL=postgresql://localhost:5432/cartelera_dev

# Instagram ingest — residential proxy all IG traffic exits through, used by
# both `cartelera ig-login` and the nightly capture so the session is minted
# and used from the same IP. Unset = direct connection (fine for local dev).
# IG_PROXY_URL=http://user:password@gate.provider.example:7000

# Instagram extraction — the litellm model string used to read captions and
# flyers. Any provider litellm supports; the code never hardcodes one.
# IG_EXTRACT_MODEL=gemini/gemini-2.5-flash
#
# Minimum per-event confidence (0..1) for an extracted event to be published.
# Below it, the event is dropped and logged — silence over noise.
# IG_CONFIDENCE_THRESHOLD=0.75
#
# The API key is whichever env var the configured provider expects and is read
# by litellm itself, not by us (e.g. GEMINI_API_KEY for gemini/*,
# ANTHROPIC_API_KEY for anthropic/*). Set it in this env; there is no
# cartelera-side config for it.
